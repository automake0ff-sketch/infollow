# Configuración de entorno para INMO FOLLOW AI
# Sección: Servidor
PORT=4000
NODE_ENV=development

# Sección: Base de datos (Supabase / Postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/inmofollow
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-key

# Sección: Autenticación (Optional - si se usa Supabase Auth en la instancia)
JWT_SECRET=change-me-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# Sección: Stripe
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_PRICE_PRO_MONTHLY=price_your-monthly-plan-price

# Sección: Inteligencia Artificial (OpenAI o similar)
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
AI_DAILY_QUOTA=1000
AI_MAX_CONTEXT_TOKENS=4000

# Sección: Frontend
VITE_API_URL=http://localhost:4000
