# INMO FOLLOW AI · Variables para Vercel (Project Settings > Environment Variables)
# Pega este bloque en "Import .env" y rellena los valores. Entornos: Production y Preview.

# ── Supabase (obligatorias) · Supabase > Project Settings > API ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── IA con OpenRouter (obligatoria para las funciones de IA; sin ella la app funciona y la IA avisa) ──
# Solo servidor. NUNCA con prefijo NEXT_PUBLIC_.
OPENROUTER_API_KEY=
# Opcional. Lista de modelos separados por comas, en orden de preferencia (se prueba el siguiente si falla).
# Por defecto: openrouter/free (elige un modelo gratuito disponible). La lista de ":free" cambia sin aviso:
# comprueba los IDs vigentes en openrouter.ai/models (filtro "Free") antes de fijarlos.
OPENROUTER_MODELS=
# Opcional. "deny" (por defecto) excluye proveedores que pueden entrenar con tus prompts. Solo pon "allow" a conciencia.
OPENROUTER_DATA_COLLECTION=deny
# Opcional. URL pública de tu app (cabecera de atribución de OpenRouter).
OPENROUTER_APP_URL=

# ── Datos legales (se muestran en /privacidad, /terminos y /dpa) ──
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_TAX_ID=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_EMAIL=
# Pon "true" SOLO cuando un profesional jurídico haya revisado los textos: oculta el aviso de "texto modelo".
NEXT_PUBLIC_LEGAL_REVIEWED=false

# ── NO añadir todavía ──
# SUPABASE_SERVICE_ROLE_KEY=   (ningún código la usa; se añadirá con el webhook de Stripe, Etapa 7)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
